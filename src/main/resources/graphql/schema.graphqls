input BookInput {
    personId: ID!
    title: String!
    isbn: String
    active: Boolean = true
}

type Book {
    id: ID!
    title: String!
    isbn: String
    active: Boolean!
}

extend type Person {
    books: [Book!]!
}

extend type Query {
    bookById(id: ID!): Book
}

extend type Mutation {
    createBook(input: BookInput!): Book!
    updateBook(id: ID!, input: BookInput!): Book!
    deleteBook(id: ID!): Boolean!
}

input PersonInput {
    firstname: String
    lastname: String
    active: Boolean = true
    email: String
}

type Person {
    id: ID!
    firstname: String
    lastname: String
    active: Boolean!
    email: String
}

type Query {
    persons: [Person!]!
    personById(id: ID!): Person
}

type Mutation {
    createPerson(input: PersonInput!): Person!
    updatePerson(id: ID!, input: PersonInput!): Person!
    deletePerson(id: ID!): Boolean!
}