input PersonInput {
    firstname: String
    lastname: String
    active: Boolean = true
    email: String
}

type Person {
    id: ID!
    firstname: String
    lastname: String
    active: Boolean!
    email: String
}

type Query {
    persons: [Person!]!
    personById(id: ID!): Person
}

type Mutation {
    createPerson(input: PersonInput!): Person!
    updatePerson(id: ID!, input: PersonInput!): Person!
    deletePerson(id: ID!): Boolean!
}